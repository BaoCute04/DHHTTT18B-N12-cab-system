# ETA Tracking Consumer Configuration

# Service
SERVICE_NAME=eta-tracking-consumer
LOG_LEVEL=info

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=eta-tracking-group

# Topics
KAFKA_TOPIC_DRIVER_LOCATION_UPDATED=driver.location.updated
KAFKA_TOPIC_TRAFFIC_UPDATES=traffic.updates

# ETA Service
ETA_SERVICE_URL=http://eta-service:3110
ETA_TIMEOUT=5000
ETA_INTERNAL_AUTH_TOKEN=eta-internal-shared-token

# Auth Service
AUTH_SERVICE_URL=http://auth-service:3104
AUTH_JWKS_URL=http://auth-service:3104/api/v1/auth/jwks
JWT_ISSUER=cab-auth-service
JWT_AUDIENCE=cab-api
SERVICE_CLIENT_ID=eta-tracking-consumer
SERVICE_CLIENT_SECRET=

# Processing
BATCH_SIZE=10
BATCH_TIMEOUT=5000
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Features
ENABLE_BIAS_CORRECTION=true
ENABLE_AI_PREDICTION=false
PUBLISH_TRAFFIC_UPDATES=true
