NODE_ENV=development
PORT=3110

ETA_REDIS_URL=redis://localhost:6379
ETA_PROVIDER_CHAIN=google,osrm,mapbox,graphhopper
ETA_ACTIVE_RIDE_TTL_SECONDS=86400
ETA_ESTIMATE_TTL_SECONDS=300
ETA_FALLBACK_TRAFFIC_FACTOR=1.18

ETA_AUTH_SERVICE_URL=http://localhost:3104
ETA_AUTH_JWKS_URL=http://localhost:3104/.well-known/jwks.json
JWT_ISSUER=cab-auth-service
JWT_AUDIENCE=cab-api
ETA_INTERNAL_AUTH_TOKEN=eta-internal-shared-token

ETA_GOOGLE_MAPS_API_KEY=
ETA_GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api/distancematrix/json
ETA_OSRM_BASE_URL=https://router.project-osrm.org
ETA_GRAPHHOPPER_API_KEY=
ETA_GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1/route
ETA_MAPBOX_ACCESS_TOKEN=
ETA_MAPBOX_BASE_URL=https://api.mapbox.com/directions/v5/mapbox/driving