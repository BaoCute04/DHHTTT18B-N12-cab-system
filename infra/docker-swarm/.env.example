STACK_NAME=cab-booking
REGISTRY=ghcr.io/your-org/cab-booking
IMAGE_TAG=latest

ADMIN_DASHBOARD_PORT=8081
CUSTOMER_APP_PORT=8082
DRIVER_APP_PORT=8083
API_GATEWAY_PORT=8080

ADMIN_DASHBOARD_REPLICAS=1
CUSTOMER_APP_REPLICAS=1
DRIVER_APP_REPLICAS=1
API_GATEWAY_REPLICAS=2
APP_SERVICE_REPLICAS=2

API_PUBLIC_URL=http://localhost:8080
WS_PUBLIC_URL=ws://localhost:8080

# Nội bộ overlay: broker apache/kafka lắng PLAINTEXT trên 19092 (9092 = PLAINTEXT_HOST cho client ngoài)
KAFKA_BROKERS=kafka:19092

POSTGRES_DB=cab_booking
POSTGRES_USER=cab_user
POSTGRES_PASSWORD=cab-postgres-password

MONGO_DB=cab_booking
MONGO_INITDB_ROOT_USERNAME=cab_root
MONGO_INITDB_ROOT_PASSWORD=cab-mongo-password

REDIS_PASSWORD=cab-redis-password

# Must match between auth-service (signing) and api-gateway (verification). Use RS256 SPKI for JWT_PUBLIC_KEY.
AUTH_JWT_ISSUER=cab-auth-service
AUTH_JWT_AUDIENCE=cab-api

# PKCS8 private key PEM and SPKI public key PEM for auth-service (RS256). In .env, wrap in quotes and use \n for line breaks.
AUTH_JWT_ACTIVE_PRIVATE_KEY_PEM=
AUTH_JWT_ACTIVE_PUBLIC_KEY_PEM=

# Gateway: SPKI public key PEM (same material as AUTH_JWT_ACTIVE_PUBLIC_KEY_PEM). Required for /ready when NODE_ENV=production.
JWT_PUBLIC_KEY=
